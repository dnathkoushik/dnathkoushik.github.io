# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust. `.env` is git-ignored.
#
# NOTE: everything prefixed with VITE_ is inlined into the JavaScript bundle and
# is therefore PUBLIC. Never put a secret, token or password in here — the whole
# bundle is downloadable by anyone who visits the site.
# ---------------------------------------------------------------------------

# Canonical origin of the deployed site. Feeds <link rel="canonical">, the
# Open Graph tags and the generated sitemap.
VITE_SITE_URL=https://dnathkoushik.github.io

# Sub-path the site is served from.
#   user/org site  (dnathkoushik.github.io)           -> /   <- this project
#   project site   (dnathkoushik.github.io/portfolio) -> /portfolio/
# The GitHub Actions workflow sets this automatically, so you only need it for
# a manual production build.
BASE_PATH=/
